# Contact form (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Convex (fill after `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional hard-stop for marketplace company seed scripts (npm run seed:companies).
# Leave unset on local/dev. Set to false to refuse seeding on a shared deployment.
# Never run seed scripts against a prod: CONVEX_DEPLOYMENT.
# ALLOW_DEV_SEED=false

# Convex Auth — Google OAuth (set on the Convex deployment, not Next.js)
# npx convex env set AUTH_GOOGLE_ID=...
# npx convex env set AUTH_GOOGLE_SECRET=...
# Google Cloud redirect URI: https://<deployment>.convex.site/api/auth/callback/google

# Cloudflare R2 PUBLIC media delivery host (non-secret; Vercel build-time config).
# Set R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME,
# R2_ENDPOINT, and this same R2_PUBLIC_BASE_URL on the Convex deployment.
# Never put the five R2 credential/config values above in Next.js .env.local,
# and never expose them through a NEXT_PUBLIC_ variable.
R2_PUBLIC_BASE_URL=
